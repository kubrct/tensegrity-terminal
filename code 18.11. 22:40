def _fmt_cz_large(val: float, curr: str) -> str:
    abs_v = abs(val)
    if abs_v >= 1e12:
        return f"{val / 1e12:.2f} bil. {curr}"
    if abs_v >= 1e9:
        return f"{val / 1e9:.2f} mld. {curr}"
    if abs_v >= 1e6:
        return f"{val / 1e6:.2f} mil. {curr}"
    return f"{val:,.0f} {curr}"


def call_external_llm_if_configured(question: str, history: list[dict], d: dict) -> str | None:
    if not GEMINI_API_KEY:
        return None
    try:
        compact_context = {
            "company": d["company_name"],
            "ticker": d["ticker"],
            "sector": d["sector"],
            "industry": d["industry"],
            "business_summary": d["business_summary"][:1200],
            "currency": d["currency"],
            "market_cap": d["trzni_kapitalizace"],
            "enterprise_value": d["celkova_hodnota_podniku"],
            "total_debt": d["celkovy_dluh"],
            "total_cash": d["hotovost"],
            "net_debt": d["cisty_dluh"],
            "fundamentals": d["fundamentals"],
            "wacc_engine": d["wacc_engine"],
            "dcf_intrinsic_per_share": d["dcf_valuation"]["intrinsic_value_per_share"],
            "current_share_price": d["dcf_valuation"]["current_share_price"],
            "tv_share_percent": d["dcf_valuation"]["tv_share_percent"],
            "fcfe_per_share": d["fcfe_valuation"]["intrinsic_value_per_share"],
            "residual_income_per_share": d["residual_income"]["intrinsic_value_per_share"],
            "peer_comps_price": d["peer_comps"]["blended_implied_price"],
            "sotp_per_share": d["metoda_souctu_casti"]["sotp_per_share"],
            "reverse_dcf": d["reverse_dcf"],
            "scenarios": d["scenarios"],
            "monte_carlo": {k: v for k, v in d["monte_carlo"].items() if k != "histogram"},
            "valuation_synthesis": d["valuation_synthesis"],
            "decision_engine": d["decision_engine"],
            "risk_analysis": d["risk_analysis"],
        }
        system_instruction = (
            "Jsi špičkový institucionální investiční a finanční analytik platformy Tensegrity Terminal. "
            "Máš plnou volnost odpovědět na JAKÝKOLIV dotaz uživatele (ať už se ptá na konkrétní číslo z modelu, "
            "význam jakéhokoliv finančního ukazatele, důvod podhodnocení či nadhodnocení, skrytá rizika, "
            "nebo jak konkrétně rozložit vlastní kapitál, např. 30 000 Kč či jinou částku, do nákupních tranší a diverzifikace). "
            "Odpovídej vždy přirozenou, srozumitelnou češtinou, věcně, konkrétně a bez šablonovitých frází.\n"
            f"Kompletní živá data aktuálně analyzované společnosti: {json.dumps(compact_context, ensure_ascii=False)}"
        )
        history_text = ""
        for msg in history[-6:]:
            role = "Uživatel" if msg.get("role") == "user" else "Poradce"
            history_text += f"{role}: {msg.get('text', '')}\n"

        prompt_body = {
            "contents": [
                {
                    "parts": [
                        {"text": f"{system_instruction}\n\nHistorie konverzace:\n{history_text}\nAktuální dotaz uživatele: {question}"}
                    ]
                }
            ]
        }
        url = f"https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key={GEMINI_API_KEY}"
        req = urllib.request.Request(
            url,
            data=json.dumps(prompt_body).encode("utf-8"),
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=15) as resp:
            raw = json.loads(resp.read().decode("utf-8"))
        candidates = raw.get("candidates") or []
        if candidates:
            parts = candidates[0].get("content", {}).get("parts") or []
            if parts and parts[0].get("text"):
                return parts[0]["text"].strip()
    except Exception as err:
        logger.warning("Externí jazykový model nebyl dostupný, přepínám na lokální analytické jádro: %s", err)
    return None


def generate_smart_advisor_answer(question: str, history: list[dict], d: dict) -> str:
    llm_reply = call_external_llm_if_configured(question, history, d)
    if llm_reply:
        return llm_reply

    q = question.lower().strip()
    curr = d["currency"]
    name = d["company_name"]
    tk = d["ticker"]
    p_now = d["dcf_valuation"]["current_share_price"]
    p_fair = d["valuation_synthesis"]["weighted_fair_value"]
    dcf_p = d["dcf_valuation"]["intrinsic_value_per_share"]
    fcfe_p = d["fcfe_valuation"]["intrinsic_value_per_share"]
    ri_p = d["residual_income"]["intrinsic_value_per_share"]
    comps_p = d["peer_comps"]["blended_implied_price"]
    sotp_p = d["metoda_souctu_casti"]["sotp_per_share"]
    mos = d["decision_engine"]["margin_of_safety_percent"]
    zone = d["decision_engine"]["zone"]
    tranche = d["decision_engine"]["tranche_allocation_percent"]
    bands = d["decision_engine"]["bands"]
    f = d["fundamentals"]
    w = d["wacc_engine"]
    rev = d["reverse_dcf"]
    sc = d["scenarios"]
    mc = d["monte_carlo"]
    rsk = d["risk_analysis"]
    lbo = d["model_odkupu_za_cizi_kapital_base_case"]

    # 1. Dotazy na rozložení kapitálu / konkrétní částku (např. "mám 30 000", "jak rozložit peníze", "kolik investovat")
    amount_match = re.search(r"(\d[\d\s\.,]*\d|\d+)\s*(tis\.?|tisíc|mil\.?|milion|kč|czk|usd|\$|eur|€)?", q)
    if any(k in q for k in ["rozložit", "kapitál", "investovat", "částk", "peněz", "peníze", "portfoli", "tranš", "kolik koupit", "alokac"]) or (
        amount_match and any(k in q for k in ["mám", "chci", "kč", "czk", "usd", "eur", "tisíc", "tis"])
    ):
        raw_num = 30000.0
        unit_label = "CZK"
        if amount_match:
            num_str = re.sub(r"[^\d,\.]", "", amount_match.group(1)).replace(",", ".")
            try:
                parsed_val = float(num_str)
                unit_raw = (amount_match.group(2) or "").lower()
                if "tis" in unit_raw:
                    parsed_val *= 1000.0
                elif "mil" in unit_raw:
                    parsed_val *= 1_000_000.0
                if parsed_val > 0:
                    raw_num = parsed_val
                if any(u in q for u in ["usd", "$", "dolar"]):
                    unit_label = "USD"
                elif any(u in q for u in ["eur", "€"]):
                    unit_label = "EUR"
            except ValueError:
                pass

        fx_rates = get_live_forex_rates()["rates"]
        usd_czk = fx_rates["USD/CZK"]["rate"]
        eur_czk = fx_rates["EUR/CZK"]["rate"]

        if unit_label == "CZK" and curr == "USD":
            invest_in_stock_curr = raw_num / usd_czk
            conv_note = f"(přepočteno živým kurzem {usd_czk:.2f} CZK/USD na cca {invest_in_stock_curr:,.2f} USD)"
        elif unit_label == "CZK" and curr == "EUR":
            invest_in_stock_curr = raw_num / eur_czk
            conv_note = f"(přepočteno živým kurzem {eur_czk:.2f} CZK/EUR na cca {invest_in_stock_curr:,.2f} EUR)"
        else:
            invest_in_stock_curr = raw_num
            conv_note = ""

        # Praktické rozložení kapitálu: max. 25–35 % portfolia do jedné akcie + rozdělení do nákupních pásem
        single_stock_cap = raw_num * 0.30
        rest_portfolio = raw_num - single_stock_cap
        t_orange = single_stock_cap * 0.25
        t_yellow = single_stock_cap * 0.35
        t_green = single_stock_cap * 0.40

        zone_advice = {
            "GREEN": f"Titul {tk} je nyní v zóně GREEN (sleva {mos:.1f} %), takže můžete okamžitě nasadit 55 % vyčleněné částky a zbytek držet jako rezervu.",
            "YELLOW": f"Titul {tk} je nyní v zóně YELLOW (sleva {mos:.1f} %), což umožňuje otevřít 30 % pozice nyní a zbylých 70 % čekat na případný pokles do zóny GREEN.",
            "ORANGE": f"Titul {tk} je v zóně ORANGE (mírný diskont {mos:.1f} %), proto je vhodné začít jen malou úvodní tranší (15 %) a hlavní kapitál nechat na lepší cenu.",
            "RED": f"Titul {tk} je aktuálně v zóně RED (tržní cena {p_now:,.2f} {curr} převyšuje váženou vnitřní hodnotu {p_fair:,.2f} {curr}), proto model doporučuje vyčkat s nákupem na pokles pod {bands['orange_max']:,.2f} {curr}.",
        }[zone]

        return (
            f"Návrh rozložení kapitálu {raw_num:,.0f} {unit_label} {conv_note} se zaměřením na {name} ({tk}):\n\n"
            f"1. Řízení rizika a diverzifikace:\n"
            f"• Do jedné jednotlivé akcie ({tk}) doporučuji alokovat nejvýše 30 % celkového kapitálu, tedy {single_stock_cap:,.0f} {unit_label} "
            f"(cca {invest_in_stock_curr * 0.30:,.2f} {curr}, což odpovídá zhruba {(invest_in_stock_curr * 0.30) / max(0.01, p_now):.2f} ks akcií při aktuální ceně).\n"
            f"• Zbývajících {rest_portfolio:,.0f} {unit_label} (70 %) rozložte mezi široký indexový fond (např. S&P 500 / MSCI World, cca 50 %) a úročenou hotovostní rezervu (cca 20 %).\n\n"
            f"2. Postupné nákupní tranše pro {tk} podle cenových zón:\n"
            f"• Aktuální stav: {zone_advice}\n"
            f"• 1. tranše (25 % alokace = {t_orange:,.0f} {unit_label}): limitní nákup v pásmu {bands['orange_min']:,.2f} – {bands['orange_max']:,.2f} {curr} (zóna ORANGE).\n"
            f"• 2. tranše (35 % alokace = {t_yellow:,.0f} {unit_label}): dokup při poklesu do {bands['yellow_min']:,.2f} – {bands['yellow_max']:,.2f} {curr} (zóna YELLOW).\n"
            f"• 3. tranše (40 % alokace = {t_green:,.0f} {unit_label}): hlavní dokup pod {bands['green_max']:,.2f} {curr} (zóna GREEN s bezpečnostní rezervou nad 20 %)."
        )

    # 2. Vysvětlení konkrétních ukazatelů a parametrů na stránce
    metric_explanations = [
        (["wacc", "náklady kapitálu", "diskont"], f"Náklady kapitálu (WACC) u {name} činí {w['wacc_percent']:.2f} % (náklady vlastního kapitálu {w['cost_of_equity_percent']:.2f} % při Betě {w['beta']:.2f} a zdaněné náklady dluhu {w['after_tax_cost_of_debt_percent']:.2f} %). Představují minimální roční výnos, který musí firma vydělat, aby uspokojila akcionáře i věřitele. Čím je WACC nižší, tím vyšší je současná hodnota budoucích peněžních toků."),
        (["roic", "návratnost", "ekonomický zisk"], f"Návratnost investovaného kapitálu (ROIC) dosahuje {f['roic_percent']:.2f} %, zatímco náklady kapitálu (WACC) jsou {w['wacc_percent']:.2f} %. Rozdíl ({f['roic_percent'] - w['wacc_percent']:+.2f} procentního bodu) generuje kladný ekonomický zisk {_fmt_cz_large(f['economic_profit'], curr)}, což potvrzuje silnou konkurenční výhodu (moat)."),
        (["beta", "volatilit"], f"Koeficient Beta společnosti {name} je {w['beta']:.2f}. Hodnota nad 1,0 znamená, že akcie reaguje na pohyby širšího trhu citlivěji (při růstu trhu o 1 % má tendenci růst o {w['beta']:.2f} %, ale při poklesu také více kolísá)."),
        (["reverzní", "obrácený", "implikovaný"], f"Obrácený (reverzní) DCF ukazuje, že aktuální tržní cena {p_now:,.2f} {curr} v sobě započítává budoucí roční růst volných peněžních toků o {rev['implied_fcf_growth_percent']:.2f} %. Náš model počítá s růstem {rev['assumed_growth_percent']:.2f} %, takže rozdíl oproti tržnímu očekávání činí {rev['expectation_gap_percent']:+.2f} procentního bodu."),
        (["monte carlo", "pravděpodobnost", "percentil", "p50"], f"Simulace Monte Carlo provedla 2 500 náhodných scénářů kombinujících kolísání růstu, marží, nákladů kapitálu i výstupního násobku. Mediánová hodnota (P50) vychází na {mc['p50']:,.2f} {curr}, 80 % výsledků leží mezi {mc['p10']:,.2f} a {mc['p90']:,.2f} {curr} a pravděpodobnost, že vnitřní hodnota převyšuje dnešní tržní cenu, je {mc['prob_above_market_percent']:.1f} %."),
        (["piotroski", "altman", "z-skóre", "z skóre", "f-skóre"], f"Piotroski F-skóre dosahuje {rsk['piotroski_f_score']} z 9 bodů (měří zlepšování ziskovosti, peněžních toků a zadlužení) a Altmanovo Z-skóre činí {rsk['altman_z_score']:.2f} ({rsk['altman_status']}), což hodnotí finanční stabilitu a odolnost proti úpadku."),
        (["lbo", "pákový", "moic", "irr", "výstupní násobek"], f"Model pákového odkupu (LBO) při {d['audit_trail']['assumptions']['leverage_percent']:.1f} % cizího kapitálu a výstupním násobku {d['audit_trail']['assumptions']['exit_multiple']:.1f}x ukazuje zhodnocení vlastního kapitálu {lbo['moic']:.2f}x (MOIC), což odpovídá roční vnitřní míře výnosnosti (IRR) {lbo['irr_procent']:.2f} %."),
        (["terminální", "terminal"], f"Terminální hodnota tvoří {d['dcf_valuation']['tv_share_percent']:.1f} % celkové hodnoty podniku v modelu DCF. Je spočítána jako průměr Gordonova růstového modelu (při dlouhodobém růstu {d['dcf_valuation']['terminal_growth']*100:.2f} %) a výstupního násobku EV/EBITDA."),
        (["bezpečnostní rezerva", "zóna", "semafor", "tranše"], f"Bezpečnostní rezerva vyjadřuje slevu tržní ceny ({p_now:,.2f} {curr}) oproti vážené vnitřní hodnotě ({p_fair:,.2f} {curr}) a aktuálně činí {mos:.2f} %. Podle této rezervy se titul nachází v zóně {zone} s doporučenou alokací {tranche} %."),
    ]
    for keywords, explanation in metric_explanations:
        if any(k in q for k in keywords):
            return explanation

    # 3. Dotazy na zadlužení, rozvahu a hotovost
    if any(k in q for k in ["dluh", "zadlužen", "hotovost", "likvidit", "solvent", "úrok", "rozvah"]):
        net_debt_txt = (
            f"čistou hotovost ve výši {_fmt_cz_large(abs(d['cisty_dluh']), curr)}"
            if d["cisty_dluh"] <= 0
            else f"čistý dluh ve výši {_fmt_cz_large(d['cisty_dluh'], curr)} ({f['net_debt_to_ebitda']:.2f}x provozního zisku)"
        )
        return (
            f"Rozvahová diagnostika společnosti {name} ({tk}):\n"
            f"• Celkový dluh činí {_fmt_cz_large(d['celkovy_dluh'], curr)}, disponibilní hotovost dosahuje {_fmt_cz_large(d['hotovost'], curr)}.\n"
            f"• Společnost tedy vykazuje {net_debt_txt}.\n"
            f"• Běžná likvidita je {f['current_ratio']:.2f}, úrokové krytí dosahuje {f['interest_coverage']:.1f}x a Altmanovo Z-skóre je {rsk['altman_z_score']:.2f} ({rsk['altman_status']})."
        )

    # 4. Dotazy na rizika, slabiny a skryté chyby
    if any(k in q for k in ["rizik", "chyb", "slab", "problém", "nebezpeč", "hrozb", "proč nekoupit", "proti"]):
        risks = []
        if d["dcf_valuation"]["tv_share_percent"] > 65:
            risks.append(f"Vysoká závislost ocenění na vzdálené budoucnosti: terminální hodnota tvoří {d['dcf_valuation']['tv_share_percent']:.1f} % výsledku DCF, takže model je citlivý na změnu úrokových sazeb.")
        if f["sbc_expense"] > f["reported_fcf"] * 0.12:
            risks.append(f"Ředění akcionářů zaměstnaneckými akciemi (SBC): náklady na akciové odměny dosahují {_fmt_cz_large(f['sbc_expense'], curr)} ročně.")
        if p_now > p_fair:
            risks.append(f"Nedostatečná bezpečnostní rezerva: tržní cena ({p_now:,.2f} {curr}) převyšuje váženou vnitřní hodnotu ({p_fair:,.2f} {curr}) o {abs(mos):.1f} %.")
        if d["cisty_dluh"] > 0 and f["net_debt_to_ebitda"] > 2.0:
            risks.append(f"Vyšší finanční páka: čistý dluh dosahuje {f['net_debt_to_ebitda']:.2f}násobku provozního zisku EBITDA.")
        if not risks:
            risks.append(f"Hlavním rizikem zůstává zpomalení tempa růstu tržeb pod očekávaných {rev['implied_fcf_growth_percent']:.1f} % ročně nebo pokles sektorových násobků.")
        return f"Klíčová rizika a citlivá místa u {name} ({tk}):\n• " + "\n• ".join(risks)

    # 5. Dotazy na důvod ocenění ("proč", "jak vyšla hodnota", "koupit nebo prodat", "vyplatí se")
    if any(k in q for k in ["proč", "vyplatí", "koupit", "prodat", "podhodnoc", "nadhodnoc", "důvod", "jak vyšl", "hodnot"]):
        direction = "podhodnocená (obchoduje se se slevou)" if p_now < p_fair else "nadhodnocená (obchoduje se s prémií)"
        return (
            f"Proč valuace {name} ({tk}) vyšla na {p_fair:,.2f} {curr} oproti tržní ceně {p_now:,.2f} {curr}:\n\n"
            f"• Akcie je podle kombinace šesti institucionálních metod {direction} o {abs(mos):.2f} % (zóna {zone}).\n"
            f"• Výnosový DCF model pro podnik ukazuje {dcf_p:,.2f} {curr} při růstu peněžních toků {d['audit_trail']['assumptions']['growth_percent']:.1f} % a WACC {w['wacc_percent']:.2f} %.\n"
            f"• Relativní srovnání se sektorem ({d['sector']}) ukazuje {comps_p:,.2f} {curr}, model reziduálního zisku {ri_p:,.2f} {curr} a medián 2 500 simulací Monte Carlo {mc['p50']:,.2f} {curr}.\n"
            f"• Závěr: {d['decision_engine']['recommendation']}."
        )

    # 6. Kontextová analytická odpověď na libovolný jiný volný dotaz uživatele
    summary_snippet = (d.get("business_summary") or "").split(".")[0:2]
    business_intro = ". ".join(s.strip() for s in summary_snippet if s.strip())
    if business_intro:
        business_intro += "."

    return (
        f"K vašemu dotazu ohledně společnosti {name} ({tk}) v kontextu aktuálních dat:\n\n"
        f"{business_intro + ' ' if business_intro else ''}"
        f"Z pohledu oceňovacího modelu se akcie obchoduje za {p_now:,.2f} {curr}, zatímco vážená vnitřní hodnota činí {p_fair:,.2f} {curr} "
        f"(pásmo scénářů od {sc['bear']['fair_value']:,.2f} {curr} v pesimistickém scénáři po {sc['bull']['fair_value']:,.2f} {curr} v optimistickém scénáři). "
        f"Firma dosahuje provozní marže {f['operating_margin_percent']:.1f} %, návratnosti kapitálu ROIC {f['roic_percent']:.1f} % a nachází se v zóně {zone} "
        f"(doporučená tranše {tranche} %). Pokud chcete rozebrat konkrétní ukazatel, scénář nebo propočet vaší investiční částky, napište mi přesný parametr nebo částku."
    )


